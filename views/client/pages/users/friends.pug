extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3
    include ../../partials/list-btn-user.pug

    .row
      .col-12
        +box-head("Danh sách bạn bè")


    .row(data-users-friend-online=user.id)
      each user in users
        .col-6(user-id=user.id)
          div(class="box-user")
            div(class="inner-avatar")
              img(
                src=(user.avatar ? user.avatar : "/img/avt.png")
                alt=user.fullName
              )
            div(class="inner-info")
              div(class="inner-name") #{user.fullName}
              div(class="inner-buttons")
                button(
                  class="btn btn-sm btn-primary mr-1"
                  btn-accept-friend = user.id
                ) Nhắn tin
              div(
                class="inner-status"
                status= user.statusOnline
                ) <i class="fa-solid fa-circle"></i> 







block scripts
  script(src="/js/users.js")